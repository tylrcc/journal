{
  "name": "journal-webapp",
  "version": "1.0.0",
  "description": "Vue 3 frontend for Journal Analysis Tool",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnmathews/journal.git",
    "directory": "webapp"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/johnmathews/journal/issues"
  },
  "homepage": "https://github.com/johnmathews/journal/tree/main/webapp#readme",
  "dependencies": {
    "@types/diff-match-patch": "^1.0.36",
    "@vueuse/core": "^12.5.0",
    "chart.js": "^4.6.1",
    "diff-match-patch": "^1.0.5",
    "pinia": "^3.0.4",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/vite": "^4.3.5",
    "@tsconfig/node22": "^22.0.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^4.1.4",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "happy-dom": "^20.8.9",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.0.2",
    "typescript": "^6.0.2",
    "vite": "^8.3.6",
    "vitest": "^4.1.4",
    "vue-tsc": "^3.3.14"
  }
}
